# 不配置也能管理本地项目和手动编辑研究种子。
# AI 接口配置见 docs/AI_SETUP.md；本机可复制为被 Git 忽略的 .env.local。
# 全部为占位，不要提交真实密钥。
# AI_API_KEY 仅供服务端使用，绝不能添加 NEXT_PUBLIC_ 前缀。
AI_API_KEY=
# 支持 OpenAI 兼容 Chat Completions + JSON object 模式，不自动选择付费模型。
# 供应商提供的 API 根地址（通常以 /v1 结尾），不含 /chat/completions。
AI_BASE_URL=
# 服务商控制台提供的准确模型标识。
AI_MODEL=
# 下列配置在后续对应阶段使用，现在不要填写虚构值。
OPENALEX_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 禁止在前端使用 Supabase service role 密钥。
