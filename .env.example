# 不配置也能管理本地项目和手动编辑研究种子。
# AI 接口配置见 docs/AI_SETUP.md；本机可复制为被 Git 忽略的 .env.local。
# 全部为占位，不要提交真实密钥。
# AI_API_KEY 仅供服务端使用，绝不能添加 NEXT_PUBLIC_ 前缀。
AI_API_KEY=
# 支持 OpenAI 兼容 Chat Completions + JSON object 模式，不自动选择付费模型。
# 供应商提供的 API 根地址（通常以 /v1 结尾），不含 /chat/completions。
AI_BASE_URL=
# 服务商控制台提供的准确模型标识。
AI_MODEL=
# 阶段 3 可选：OpenAlex 个人密钥，仅服务端读取。
# 本轮匿名访问已实测可用，但共享出口免费额度，政策可能变化；见 docs/LITERATURE.md。
OPENALEX_API_KEY=
# Supabase 尚未接入，不要填写虚构值。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 禁止在前端使用 Supabase service role 密钥。

# AI 学术联网检索：仅使用官方 DeepSeek Search/Fetch，按成功请求计费。
# 服务端专用；仅填这一项时，批量分析默认采用 deepseek-flash（另计模型 token 费用）。
# 不要提交真实密钥；完整说明见 docs/SEARCH_DELIVERY.md。
DEEPSEEK_API_KEY=
